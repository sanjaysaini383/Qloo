# Qloo hackathon API key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Leave empty to run with fictional offline demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Agent brain. Gemini runs the agent when GEMINI_API_KEY is set (https://aistudio.google.com/apikey).
# If a model is overloaded or out of quota, Roadie switches to the next one in GEMINI_FALLBACK_MODELS.
# With no LLM key, the deterministic Autopilot plans the tour from the same Qloo tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Optional alternative engine: Claude takes priority when ANTHROPIC_API_KEY is set (https://console.anthropic.com).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional per-IP limits for the public demo
PLAN_LIMIT_PER_HOUR=12
CHAT_LIMIT_PER_HOUR=40
