# Qloo hackathon API key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Leave empty to run with fictional offline demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Google Gemini API key (https://aistudio.google.com/apikey)
# Leave empty to run the deterministic Autopilot planner instead of the LLM agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional per-IP limits for the public demo
PLAN_LIMIT_PER_HOUR=12
CHAT_LIMIT_PER_HOUR=40
