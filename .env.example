# Qloo hackathon API key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Leave empty to run with fictional offline demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Agent brain. Claude is used when ANTHROPIC_API_KEY is set (https://console.anthropic.com),
# otherwise Gemini when GEMINI_API_KEY is set. With neither, the deterministic Autopilot plans the tour.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional per-IP limits for the public demo
PLAN_LIMIT_PER_HOUR=12
CHAT_LIMIT_PER_HOUR=40
